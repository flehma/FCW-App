# -- 1. Mannschaft --
DATABASE_NAME_ERSTE=fcw_erste
DATABASE_USER_ERSTE=fcw_erste_user
DATABASE_PASSWORD_ERSTE=changeme
DATABASE_ROOT_PASSWORD_ERSTE=changeme_root

# -- 2. Mannschaft (bisherige Werte aus der alten .env uebernehmen!) --
DATABASE_NAME_ZWEITE=changeme_bestehender_wert
DATABASE_USER_ZWEITE=changeme_bestehender_wert
DATABASE_PASSWORD_ZWEITE=changeme_bestehender_wert
DATABASE_ROOT_PASSWORD_ZWEITE=changeme_bestehender_wert

# -- Login (gilt fuer BEIDE Teams gemeinsam, da ein .env-File genutzt wird) --
# Nutzer im Format "user1:passwort1,user2:passwort2"
# Bitte sicherstellen, dass hier die bisherigen echten Werte eingetragen werden!
AUTH_USERS_ERSTE=admin:Test123!,fcwuser:IngeAufDie1
AUTH_USERS_ZWEITE=admin:Test123!,fcwuser:HGL14
NUXT_SESSION_PASSWORD=icherstelleeinlangespasswort!FCW

# Hinweis: Login/Session sind aktuell fuer beide Instanzen identisch,
# da beide Container dieselbe .env lesen. Falls getrennte Logins pro Team
# gewuenscht sind, muesste AUTH_USERS pro Instanz per "environment:" im
# docker-compose.yml ueberschrieben werden - sag Bescheid, dann bau ich das.
